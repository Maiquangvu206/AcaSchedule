# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=acaschedule
POSTGRES_PASSWORD=acaschedule
POSTGRES_DB=acaschedule
DATABASE_URL=postgresql://acaschedule:acaschedule@db:5432/acaschedule

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3 compatible object storage) ──────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Host/port browser uses for presigned upload/download URLs.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_REGION=us-east-1

# ── AI Advisor (Gemini) ───────────────────────────────────────
# Điền key để kích hoạt AI Service. Để trống nếu chưa dùng.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# URL nội bộ của AI service (backend proxy /api/ai/* tới đây).
AI_SERVICE_URL=http://ai:8000

# ── Auth / JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seeding (creates the admin account only) ────────────────────
SEED_ADMIN_EMAIL=admin@acaschedule.local
SEED_ADMIN_PASSWORD=Admin@123
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
